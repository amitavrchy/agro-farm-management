generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum FarmTypology {
  INDIVIDUAL_SMALL
  INDIVIDUAL_COMMERCIAL
  GROUP_COOPERATIVE
  CONTRACT_FARMING
  MULTI_FARM_ORG
}

enum ProductionSystem { CROP HORTICULTURE LIVESTOCK DAIRY POULTRY AQUACULTURE MIXED }
enum VendorType { VET FEED_SELLER SEED_SUPPLIER FERTILIZER_SUPPLIER PESTICIDE_SUPPLIER EQUIPMENT_RENTAL LABOR_CONTRACTOR BUYER_AGGREGATOR TRANSPORT OTHER }

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  fullName     String
  fullNameBn   String?
  locale       String   @default("bn")
  createdAt    DateTime @default(now())
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  typology  FarmTypology @default(INDIVIDUAL_SMALL)
  status    String   @default("ACTIVE")
  timezone  String   @default("Asia/Dhaka")
  locale    String   @default("bn")
}

model UserOrgRole {
  id     String @id @default(cuid())
  userId String
  orgId  String
  role   String
  @@unique([userId, orgId, role])
}

model Farm {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  code        String
  typology    FarmTypology
  systems     ProductionSystem[]
  lat         Float?
  lng         Float?
  // location geography(Point,4326) via raw SQL
  areaHectares Decimal? @db.Decimal(12, 4)
  timezone    String   @default("Asia/Dhaka")
  status      String   @default("ACTIVE")
  @@unique([orgId, code])
}

model UserFarmRole {
  id     String @id @default(cuid())
  userId String
  farmId String
  role   String
  @@unique([userId, farmId, role])
}

model LandUnit {
  id          String   @id @default(cuid())
  farmId      String
  parentId    String?
  kind        String   // PLOT BLOCK POND SHED BARN GREENHOUSE
  name        String
  // geom geography(Polygon,4326) via migration
  areaHectares Decimal  @db.Decimal(12, 4)
  soilType    String?
  irrigation  String?
  status      String   @default("ACTIVE")
  @@index([farmId, status])
}

model CropCycle {
  id           String   @id @default(cuid())
  farmId       String
  landUnitId   String
  parentCycleId String?
  cropName     String
  varietyId    String?
  season       String?
  status       String
  plantedOn    DateTime? @db.Date
  plannedHarvestOn DateTime? @db.Date
  contracted   Boolean  @default(false)
  contractId   String?
  @@index([farmId, status])
}

model CycleActivity {
  id         String   @id @default(cuid())
  cycleId    String
  type       String   // SOW IRRIGATE FERTILIZE SPRAY SCOUT HARVEST
  scheduledAt DateTime?
  doneAt     DateTime?
  qty        Decimal? @db.Decimal(14, 3)
  inventoryBatchId String?
  notes      String?
  clientEventId String? @unique
}

model Animal {
  id         String   @id @default(cuid())
  orgId      String
  farmId     String
  species    String   // CATTLE BUFFALO GOAT SHEEP CHICKEN DUCK etc.
  purpose    String?  // DAIRY MEAT DRAFT BREEDING
  visualTag  String
  eid        String?
  sex        String?
  dob        DateTime? @db.Date
  damId      String?
  sireId     String?
  status     String   @default("ACTIVE")
  groupId    String?
  @@unique([orgId, visualTag])
  @@index([farmId, species, status])
}

model AnimalGroup {
  id       String @id @default(cuid())
  farmId   String
  name     String
  kind     String // HERD FLOCK BATCH
}

model AnimalEvent {
  id        String   @id @default(cuid())
  animalId  String?
  groupId   String?
  type      String   // WEIGHT MILK EGGS MOVE BREED PREGNANCY BIRTH DEATH SALE
  at        DateTime
  qty       Decimal? @db.Decimal(14, 3)
  meta      Json?
  clientEventId String? @unique
}

model HealthProtocol {
  id       String @id @default(cuid())
  orgId    String
  species  String
  name     String
  schedule Json   // [{day, productId, dose}]
}

model HealthEvent {
  id            String   @id @default(cuid())
  animalId      String?
  groupId       String?
  productId     String?
  type          String   // VACCINE TREATMENT DEWORM
  status        String
  scheduledAt   DateTime?
  givenAt       DateTime?
  withdrawalEndsAt DateTime?
  vetVendorId   String?
  bookingId     String?
}

model PondStocking {
  id          String   @id @default(cuid())
  farmId      String
  landUnitId  String
  species     String
  stockedAt   DateTime @db.Date
  seedCount   Int
  status      String
}

model FeedRecipe {
  id     String @id @default(cuid())
  orgId  String
  name   String
  target Json?
  lines  Json   // [{itemId, pct}]
}

model FeedBatch {
  id        String @id @default(cuid())
  recipeId  String
  qtyKg     Decimal @db.Decimal(14, 3)
  costMinor Int
  mixedAt   DateTime @default(now())
}

model InventoryItem {
  id       String @id @default(cuid())
  orgId    String
  sku      String
  name     String
  kind     String // SEED FERTILIZER PESTICIDE FEED DRUG FUEL OTHER
  unit     String
  restricted Boolean @default(false)
  @@unique([orgId, sku])
}

model InventoryBatch {
  id         String   @id @default(cuid())
  itemId     String
  farmId     String?
  lotNumber  String?
  expiryDate DateTime? @db.Date
  qtyOnHand  Decimal  @db.Decimal(14, 3)
  costMinor  Int
  status     String   @default("ACTIVE")
  @@index([itemId, expiryDate])
}

model Device {
  id         String @id @default(cuid())
  farmId     String
  name       String
  kind       String // SOIL_MOISTURE WEATHER_STATION TANK_DO TEMP CAMERA
  keyHash    String
  landUnitId String?
  status     String @default("ACTIVE")
}

model SensorReading {
  id       String   @id @default(cuid())
  deviceId String
  metric   String
  value    Decimal  @db.Decimal(18, 6)
  at       DateTime
  @@index([deviceId, metric, at])
}

model WeatherSnapshot {
  id        String   @id @default(cuid())
  farmId    String
  at        DateTime
  source    String
  tempC     Decimal? @db.Decimal(6, 2)
  rainfallMm Decimal? @db.Decimal(8, 2)
  humidity  Decimal? @db.Decimal(5, 2)
  raw       Json?
  @@index([farmId, at])
}

model ForecastRun {
  id           String   @id @default(cuid())
  cycleId      String?
  pondId       String?
  modelVersion String
  forecastQty  Decimal  @db.Decimal(14, 3)
  unit         String
  inputs       Json
  createdAt    DateTime @default(now())
}

model CostLedgerEntry {
  id          String   @id @default(cuid())
  orgId       String
  farmId      String?
  costCenter  String
  entityType  String
  entityId    String
  sourceType  String
  sourceId    String
  amountMinor Int
  memo        String?
  at          DateTime @default(now())
  @@index([orgId, entityType, entityId])
}

model HarvestLot {
  id         String   @id @default(cuid())
  farmId     String
  cycleId    String?
  pondStockingId String?
  lotCode    String
  qty        Decimal  @db.Decimal(14, 3)
  unit       String
  grade      String?
  status     String
  traceQr    String   @unique
  @@unique([farmId, lotCode])
}

model Sale {
  id          String   @id @default(cuid())
  orgId       String
  farmId      String
  buyerName   String?
  marketplaceOrderId String?
  contractId  String?
  totalMinor  Int
  status      String
  soldAt      DateTime @default(now())
}

model OfftakeContract {
  id             String @id @default(cuid())
  orgId          String
  farmId         String?
  buyerName      String
  buyerVendorId  String?
  status         String
  product        String
  volumeQty      Decimal? @db.Decimal(14, 3)
  priceTerms     Json
  advanceMinor   Int @default(0)
}

model CoopMember {
  id             String @id @default(cuid())
  orgId          String
  userId         String?
  name           String
  shareUnits     Decimal @db.Decimal(14, 4)
  status         String
}

model CoopPolicy {
  orgId            String @id
  wCapitalBps      Int
  wPatronageBps    Int
  wEqualBps        Int
  reserveBps       Int @default(0)
}

model DividendRun {
  id     String @id @default(cuid())
  orgId  String
  period String
  status String
  distributableMinor Int
}

model LoanFacility {
  id             String @id @default(cuid())
  orgId          String
  lender         String
  principalMinor Int
  status         String
  terms          Json?
}

model SubsidyClaim {
  id          String @id @default(cuid())
  orgId       String
  programName String
  amountMinor Int
  status      String
}

model Vendor {
  id             String @id @default(cuid())
  ownerId        String
  slug           String @unique
  businessName   String
  type           VendorType
  status         String
  commissionBps  Int @default(1000)
  lat            Float?
  lng            Float?
  serviceRadiusKm Int?
}

model VendorKyc {
  vendorId  String @id
  documents Json
  licenses  Json?
  status    String
  reviewedAt DateTime?
}

model VendorService {
  id              String @id @default(cuid())
  vendorId        String
  title           String
  kind            String // VISIT TELECONSULT RENTAL LABOR TRANSPORT
  durationMinutes Int @default(60)
  priceMinor      Int
  bufferMinutes   Int @default(0)
}

model VendorProduct {
  id         String @id @default(cuid())
  vendorId   String
  name       String
  sku        String?
  priceMinor Int
  stockQty   Decimal? @db.Decimal(14, 3)
  restricted Boolean @default(false)
}

model Booking {
  id          String   @id @default(cuid())
  vendorId    String
  serviceId   String
  orgId       String
  farmId      String?
  status      String
  startAt     DateTime
  endAt       DateTime
  priceMinor  Int
  @@index([vendorId, startAt, endAt])
}

model MarketplaceOrder {
  id          String @id @default(cuid())
  vendorId    String
  orgId       String
  status      String
  goodsMinor  Int
  commissionMinor Int @default(0)
  clientOrderId String? @unique
}

model Review {
  id        String @id @default(cuid())
  vendorId  String
  userId    String
  bookingId String? @unique
  orderId   String? @unique
  rating    Int
  body      String?
}

model Payment {
  id             String @id @default(cuid())
  provider       String
  status         String
  amountMinor    Int
  currency       String @default("BDT")
  bookingId      String?
  orderId        String?
  saleId         String?
  idempotencyKey String @unique
  providerRef    String?
}

model TeleconsultSession {
  id        String @id @default(cuid())
  bookingId String @unique
  provider  String
  status    String
  roomName  String?
}

model VendorBalance {
  vendorId       String @id
  availableMinor Int @default(0)
  pendingMinor   Int @default(0)
}

model OutboxEvent {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model SyncEvent {
  id             String    @id @default(cuid())
  farmId         String
  deviceId       String?
  clientEventId  String    @unique
  type           String
  payload        Json
  status         String
  receivedAt     DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  orgId     String?
  farmId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
  @@index([orgId, createdAt])
}

model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  payload         Json
  processedAt     DateTime?
  @@unique([provider, providerEventId])
}
